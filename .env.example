# Phase 3 — environment template. Copy to `.env` and fill in.
# NEVER commit real secrets. `.env` is git-ignored.

# PostgreSQL connection string (required for database features).
# The website + admin UI keep working on demo data when this is empty.
DATABASE_URL=""

# Phase 4 — session signing secret (required for real authentication).
# Minimum 16 characters. Generate with: openssl rand -base64 48
# Real login, middleware protection and API role checks stay disabled
# (honest 503 / demo fallback) until this is set.
SESSION_SECRET=""

# Optional: direct connection for migrations when using a pooled URL above.
# Deploy note: run `npm run db:migrate:deploy` (prisma migrate deploy) on
# release — Docker CMD and Vercel builds do NOT auto-migrate.
# Add this script to package.json: "db:migrate:deploy": "prisma migrate deploy"
DIRECT_URL=""

# PDF import OCR gate. Scanned/image PDFs need native canvas + Tesseract,
# which is unreliable on Vercel serverless: leave empty (or "false") and
# such imports fail closed with code OCR_NOT_AVAILABLE. Set OCR_ENABLED=true
# (or "local") only where native OCR can run: local dev, Docker, or the
# dedicated OCR worker host. Text-based PDFs import regardless of this flag.
# OCR_ENABLED=""

# Public site configuration (used by robots/sitemap/course pages; safe to
# expose — NEXT_PUBLIC_ vars ship to the browser).
NEXT_PUBLIC_SITE_URL="https://neuronacademy.in"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/919999999999"

# Phase 18 — MSG91 OTP (production student mobile verification, SERVER-ONLY).
# Where to get each value (https://control.msg91.com → OTP section):
# - MSG91_AUTH_KEY:    authentication credential (authkey). Dashboard API key.
#                      Used ONLY server-side by services/msg91.ts to call
#                      POST https://api.msg91.com/api/v5/otp. NEVER expose to
#                      the browser, NEVER log, NEVER commit the real value.
# - MSG91_TEMPLATE_ID: DLT-approved OTP template ID whose message variable
#                      carries the OTP (template must contain the OTP
#                      placeholder, e.g. ##OTP##). Sent as `template_id`.
# - MSG91_SENDER_ID:   registered sender ID (DLT header). Sent as `sender`.
# - MSG91_OTP_EXPIRY:  OTP validity in minutes (1–30, default 5). Sent as
#                      `otp_expiry` and enforced server-side on OtpRequest.
# Prerequisites: MSG91 account + approved DLT template + registered sender ID.
# NEVER commit real credentials. Until all three MSG91_* values are set, OTP
# APIs honestly return OTP_CONFIGURATION_ERROR (503) and registration keeps
# its legacy flow. OTP codes are 6-digit, hashed (peppered SHA-256) at rest,
# rate-limited (60s resend cooldown, 5 sends/hour, 5 verify attempts/code).
# Local config: copy this file to .env and fill the four values, e.g.
#   cp .env.example .env
#   # then edit .env — keep it git-ignored and restart the server.
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID=""
# OTP validity in minutes (1–30, default 5).
MSG91_OTP_EXPIRY="5"

# Phase 18b — transactional SMS (notification engine, OPTIONAL).
# The engine sends non-OTP SMS via the MSG91 Flow API v5 (ChannelRouter →
# SmsProvider → Msg91Provider). Per-template Flow IDs — configure ONLY the
# templates you send; missing IDs honestly skip SMS (push + in-app still go).
# Create each Flow in the MSG91 dashboard with variables named exactly:
# academyName, studentName, facultyName, testName, batchName, testDate,
# testTime, result, message. Template bodies live in lib/sms-templates.ts.
# NOT live-verified: verify with the transactional smoke command first.
# MSG91_FLOW_ID_TEST_PUBLISHED=""
# MSG91_FLOW_ID_TEST_REMINDER=""
# MSG91_FLOW_ID_RESULT_RELEASED=""
# MSG91_FLOW_ID_ATTENDANCE_ABSENT=""
# MSG91_FLOW_ID_BATCH_ANNOUNCEMENT=""
# MSG91_FLOW_ID_ADMIN_ANNOUNCEMENT=""
# MSG91_FLOW_ID_ACADEMIC_NOTICE=""
# MSG91_FLOW_ID_ADMISSION_UPDATE=""
# MSG91_FLOW_ID_ACCESS_GRANTED=""
# MSG91_FLOW_ID_ACCESS_REVOKED=""
# MSG91_FLOW_ID_FACULTY_NOTIFICATION=""
# MSG91_FLOW_ID_EMERGENCY_ALERT=""
# Display name for SMS/notification copy (safe, non-secret).
# ACADEMY_NAME="Neuron Academy"

# Phase 13 — Web Push foundation (browser push lands in a later phase).
# Generate with: npx web-push generate-vapid-keys
# Subscriptions are stored once set; delivery needs a push provider.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Phase 19 — scheduled notification worker (SERVER-ONLY cron).
# GET /api/cron/notifications?limit=25 runs every 5 minutes (see vercel.json).
# Generate with: openssl rand -base64 48
# Vercel Cron sends it as `Authorization: Bearer <secret>` when CRON_SECRET
# is set on the project. The route compares in constant time, returns
# 401/503 without processing on missing/invalid, and never logs the value.
# Until this is set the worker fails closed (503 CRON_NOT_CONFIGURED).
# CRON_SECRET=""

# File storage (profile photos, book covers, book PDFs).
# "local" serves from public/uploads/ — dev/single-server ONLY. Files vanish
# on Vercel redeploys; NEVER use local in production.
# Production MUST use STORAGE_PROVIDER=supabase with a PRIVATE bucket:
# objects are keyed photos| covers | book-pdfs/<generated-name>, the database
# stores supabase://<bucket>/<key> refs, and the server mints short-lived
# signed URLs at read time. Book covers are the one public asset (long-lived
# signed URLs generated at read). SUPABASE_SERVICE_KEY is SERVER ONLY —
# it must never appear in client bundles or API responses.

SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
STORAGE_PROVIDER=supabase
STORAGE_BUCKET="neuron-academy"
