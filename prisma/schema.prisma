datasource db {
  provider = "postgresql"
}

// ================================================================
// Biometric Device Management
// ================================================================
// Device registration — admin-managed. Each physical X2000 device
// registered in the system. Credentials stored securely; never exposed
// to frontend or mobile clients.
//
// Device → Backend API only. Student/Faculty apps never communicate
// directly with the biometric device.
//
// Last communication tracking for admin dashboard health visibility.
model BiometricDevice {
  id            String           @id @default(cuid())
  name          String
  serialNumber  String   @unique
  deviceType    String       @default("X2000")
  ipAddress     String?
  port          Int?
  protocol      String       @default("ADMS")
  location      String?
  isActive      Boolean        @default(true)
  lastSeenAt    DateTime?
  totalEvents   Int            @default(0)
  failedEvents  Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isActive])
  @@index([lastSeenAt])
}

model BiometricDeviceEvent {
  id                String           @id @default(cuid())
  deviceId          String?          // FK to BiometricDevice
  biometricUserId   String
  eventTimestamp    DateTime @default(now())
  eventType         String
  payloadHash       String           @db.VarChar(64) // SHA-256 hex string
  processed         Boolean          @default(false)
    // True if an Attendance record was created/resolved from this event
  attendanceId      String?
    // Link to created Attendance row (if processed)
  receivedAt        DateTime         @default(now())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([deviceId])
  @@index([biometricUserId])
  @@index([processed])
  @@index([eventTimestamp])

  @@unique([deviceId, biometricUserId, eventTimestamp, payloadHash])
}

// ================================================================
// Legacy models from baseline migration — referenced for relations.
// These types are defined in migration 20261006000000_baseline SQL.
// ================================================================

enum AttendanceSource {
  MANUAL
  BIOMETRIC
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

model Student {
  id        String   @id @default(cuid())
  name      String
  email     String
}

model Batch {
  id        String   @id @default(cuid())
  name      String
}

// Prisma Client generator configuration.
// This block is managed by prisma.config.ts; do not remove.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}