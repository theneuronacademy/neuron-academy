// Phase 3 — PostgreSQL schema (Prisma ORM).
// Frontend + existing test engine (lib/storage.ts, lib/testTypes.ts) are
// UNTOUCHED. These models are the production foundation; the localStorage
// test engine keeps working until the API-backed engine lands.
// Passwords are NEVER stored in plaintext — see prisma/seed.ts (bcryptjs).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Phase 14.1 — keep the classic node_modules client in sync with the same
// schema (lib/prisma.ts and most routes import from "@prisma/client").
// Generator-only change: zero DB/migration impact.
generator client_legacy {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

// Phase 14 — student type. REGULAR = full academic experience; SCHOLARSHIP =
// scholarship/FREE tests + profile + notifications + enabled books only.
// Enforced server-side on every route; never trusted from the client.
enum StudentType {
  REGULAR
  SCHOLARSHIP
}

// Phase 14 — per-book visibility for scholarship students.
enum BookVisibility {
  ALL
  REGULAR_ONLY
}

enum FacultyStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  ACTIVE
  INACTIVE
}

enum BatchStatus {
  ACTIVE
  UPCOMING
  COMPLETED
}

enum TestType {
  LIVE
  OFFLINE
  PRACTICE
}

enum TestStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  PUBLISHED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  NUMERIC
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  LEAVE
}

enum AttendanceSource {
  MANUAL
  BIOMETRIC
}

enum NotificationAudience {
  ALL_STUDENTS
  BATCH
  FACULTY
  INDIVIDUAL
}

enum NotificationStatus {
  DRAFT
  SCHEDULED
  SENT
}

// Phase 13 — test access model (FREE open | PAID manual grant after UPI | PRIVATE invite-only).
enum TestAccessType {
  FREE
  PAID
  PRIVATE
}

enum TestAccessStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

// Phase 13 — notification delivery channels. Only IN_APP is delivered today;
// WEB_PUSH / MOBILE_PUSH rows are stored so future providers need no rework.
enum NotificationChannel {
  IN_APP
  WEB_PUSH
  MOBILE_PUSH
}

// Phase 18c-step3 — persisted priority (engine-only before). Arbitrary
// strings are never accepted; resolvePriority() allowlists these four.
enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

// Phase 18c-step3 — per-recipient delivery channel. PUSH covers web-push
// today (mobile push reuses the same lane until a dedicated provider lands).
enum DeliveryChannel {
  SMS
  PUSH
  IN_APP
}

// Phase 18c-step3 — delivery state machine. Meaning:
//   CREATED .... delivery row persisted, not yet queued
//   QUEUED ..... recipients + channels resolved, dispatch starting
//   PROCESSING . fan-out in progress for this recipient/channel
//   SENT ...... provider accepted (MSG91 Flow success / push provider
//               acceptance). DELIVERED is NEVER claimed on acceptance.
//   DELIVERED . in-app row visible to the recipient (durable local write),
//               or a future provider delivery receipt. SMS never uses this.
//   FAILED .... channel failed; other channels still attempted (isolation)
//   RETRYING .. marked retryable for a future worker (no auto-retry here)
//   SKIPPED ... channel not in policy / unconfigured / invalid recipient /
//               fan-out cap overflow. Counted explicitly, never hidden.
enum DeliveryStatus {
  CREATED
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  RETRYING
  SKIPPED
}

// Phase 18c-step3 — which provider owns the lane. INTERNAL = durable
// in-app write (no network). MSG91 = transactional SMS Flow API.
// WEB_PUSH = VAPID provider (stubbed until installed).
enum DeliveryProvider {
  IN_APP
  MSG91
  WEB_PUSH
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

enum PopupFrequency {
  ONCE_PER_SESSION
  ONCE_PER_DAY
  EVERY_VISIT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  // Phase 10: one-way credential for ADMIN mobile+DOB login.
  // bcrypt(SESSION_SECRET + dobISO). Never returned, logged, or sent out.
  dobHash      String?
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  studentProfile      Student?
  facultyProfile      Faculty?
  createdTests        Test[]         @relation("TestCreator")
  createdImports      PdfImport[]    @relation("PdfImportCreator")
  createdNotifications Notification[] @relation("NotificationCreator")
  createdAnnouncements Announcement[] @relation("AnnouncementCreator")
  // Phase 13 — access grants performed by this admin + push subscriptions.
  grantedAccesses TestAccess[] @relation("AccessGranter")
  pushSubscriptions PushSubscription[]
  targetedUserNotifications Notification[] @relation("NotificationUser")
  // Phase 18c-step3 — per-recipient delivery rows for this user (audit only).
  notificationDeliveries NotificationDelivery[] @relation("DeliveryRecipient")
}

model Student {
  id          String        @id @default(cuid())
  userId      String?       @unique
  studentId   String        @unique
  name        String
  email       String        @unique
  phone       String
  photo       String?
  courseId    String?
  batchId     String?
  joiningDate DateTime      @default(now())
  status      StudentStatus @default(ACTIVE)
  // Phase 14 — student type + profile. mobile/email/studentType/batch are
  // admin-managed; students edit only the allowlisted profile fields.
  studentType   StudentType @default(REGULAR)
  dob           DateTime?
  photoUrl      String?
  gender        String?
  address       String?
  city          String?
  school        String?
  className     String?
  parentName    String?
  parentMobile  String?
  enrollmentDate DateTime   @default(now())
  lastLoginAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user       User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  course     Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  batch      Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  attendance Attendance[]
  attempts   TestAttempt[]
  results    Result[]
  targetedNotifications Notification[] @relation("NotificationStudent")
  // Phase 13 — PAID/PRIVATE test grants for this student.
  testAccesses TestAccess[]
  // Engagement: revise-later bookmarks + asked doubts.
  bookmarks Bookmark[]
  doubts    Doubt[]

  @@index([studentType])
  @@index([status])
  @@index([batchId])
}

model Faculty {
  id            String        @id @default(cuid())
  userId        String?       @unique
  facultyId     String        @unique
  name          String
  email         String        @unique
  phone         String
  photo         String?
  qualification String?
  experience    String?
  bio           String?
  // Public faculty-page fields (subject filter, card designation).
  subject       String?
  designation   String?        @default("Faculty")
  status        FacultyStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user                 User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  batches              Batch[]
  targetedNotifications Notification[] @relation("NotificationFaculty")
  timetableEntries TimetableEntry[]
}

model Course {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  description      String?
  shortDescription String?
  image            String?
  duration         String?
  fee              Float?
  status           CourseStatus @default(ACTIVE)
  displayOrder     Int          @default(0)
  // Website catalogue fields (filter pills, cards) — kept so the public
  // site maps 1:1 without placeholder defaults once seeded from /data/courses.
  category         String       @default("Engineering")
  target           String?
  mode             String?
  facultyName      String?
  badge            String?
  accent           String?
  subjects         String[]     @default([])
  highlights       String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  students  Student[]
  batches   Batch[]
  enquiries Enquiry[]
}

model Batch {
  id        String      @id @default(cuid())
  name      String
  courseId  String
  facultyId String?
  startDate DateTime?
  endDate   DateTime?
  status    BatchStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  course        Course         @relation(fields: [courseId], references: [id], onDelete: Restrict)
  faculty       Faculty?       @relation(fields: [facultyId], references: [id], onDelete: SetNull)
  students      Student[]
  tests         Test[]
  attendance    Attendance[]
  notifications Notification[] @relation("NotificationBatch")
  timetableEntries TimetableEntry[]
  doubts           Doubt[]
}

model Banner {
  id           String   @id @default(cuid())
  title        String
  subtitle     String?
  description  String?
  imageUrl     String?
  videoUrl     String?
  buttonText   String?
  buttonUrl    String?
  startDate    DateTime?
  endDate      DateTime?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Popup {
  id         String         @id @default(cuid())
  title      String
  message    String
  imageUrl   String?
  videoUrl   String?
  buttonText String?
  buttonUrl  String?
  frequency  PopupFrequency @default(ONCE_PER_SESSION)
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  description  String?
  imageUrl     String
  category     String   @default("Academy")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Testimonial {
  id           String   @id @default(cuid())
  name         String
  role         String   @default("Student")
  message      String
  photo        String?
  rating       Int      @default(5)
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Result {
  id         String   @id @default(cuid())
  studentId  String
  testId     String
  marks      Float    @default(0)
  totalMarks Float    @default(0)
  percentage Float    @default(0)
  rank       Int?
  status     String   @default("PUBLISHED")
  // Server-computed breakdown (Step 13 response fields).
  attempted  Int      @default(0)
  correct    Int      @default(0)
  wrong      Int      @default(0)
  unanswered Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([studentId])
  @@index([studentId, testId])
}

// Phase 13 — manual student access grants for PAID/PRIVATE tests.
// Payment happens externally (UPI); an ADMIN creates an ACTIVE row after
// confirming payment. One ACTIVE row per (test, student) — enforced by the
// composite unique on (testId, studentId, status): re-grant after revoke
// works because the old row is REVOKED/EXPIRED, never a second ACTIVE.
model TestAccess {
  id        String           @id @default(cuid())
  testId    String
  studentId String
  grantedBy String?
  status    TestAccessStatus @default(ACTIVE)
  grantedAt DateTime         @default(now())
  expiresAt DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  granter User?   @relation("AccessGranter", fields: [grantedBy], references: [id], onDelete: SetNull)

  @@unique([testId, studentId, status])
  @@index([studentId])
  @@index([testId])
  @@index([status])
  @@index([studentId, testId])
}

// Compatible with the existing test engine contract (lib/testTypes.ts):
// title=name, duration=durationMinutes, totalQuestions=questionIds.length.
// The localStorage engine (lib/storage.ts) is NOT replaced in this phase.
model Test {
  id             String     @id @default(cuid())
  title          String
  description    String?
  batchId        String?
  createdById    String?
  type           TestType   @default(PRACTICE)
  duration       Int        @default(60)
  totalQuestions Int        @default(0)
  totalMarks     Int        @default(0)
  startTime      DateTime?
  endTime        DateTime?
  status         TestStatus @default(DRAFT)
  // Phase 12 — test generator ordering (SERIAL | RANDOM).
  questionOrder  String     @default("SERIAL")
  optionOrder    String     @default("SERIAL")
  // Phase 13 — access model. FREE = open to eligible students, PAID =
  // admin grants TestAccess after external UPI payment (no gateway),
  // PRIVATE = invite-only via TestAccess. No payment provider is used.
  accessType   TestAccessType @default(FREE)
  // Price in integer rupees. FREE must be 0, PAID must be > 0.
  price        Int            @default(0)
  publishedAt  DateTime?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  batch     Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  createdBy User?        @relation("TestCreator", fields: [createdById], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  TestAttempt[]
  results   Result[]
  accesses  TestAccess[]
  bookmarks Bookmark[]
  // Homework flag: PRACTICE tests assigned as homework (faculty-created for
  // assigned batches, FREE). No new TestType enum — plain boolean, no
  // transaction-unsafe enum surgery.
  isHomework Boolean @default(false)

  @@index([status])
  @@index([accessType])
  @@index([publishedAt])
  @@index([batchId])
  @@index([isHomework])
}

// questionType supports future types (comprehension, matrix) without
// complicating today's MCQ-first engine. Options stay nullable so new
// types don't force fake A-D options.
model Question {
  id            String       @id @default(cuid())
  testId        String
  questionText  String
  questionType  QuestionType @default(MCQ)
  optionA       String?
  optionB       String?
  optionC       String?
  optionD       String?
  // Phase 12 — 5th option support (variable 2–5 options).
  optionE       String?
  correctAnswer String?
  marks         Float        @default(1)
  negativeMarks Float        @default(0)
  explanation   String?
  order         Int          @default(0)
  // Phase 12 — import provenance + review pipeline.
  // subject groups pool filtering; reviewStatus: PENDING | APPROVED | REJECTED.
  // confidence: HIGH | MEDIUM | LOW (parser-assessed, faculty reviews).
  subject       String?
  sourceFile    String?
  sourcePage    Int?
  confidence    String?
  reviewStatus  String       @default("APPROVED")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)
  bookmarks Bookmark[]

  @@index([testId])
}

model TestAttempt {
  id          String        @id @default(cuid())
  testId      String
  studentId   String
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  // Submitted answers { questionId: "A"|"B"|"C"|"D"|null } — persisted so
  // evaluation is reproducible server-side. Never trust client marks.
  answers     Json?
  // Phase 12 — server-generated per-attempt ordering (RANDOM modes).
  // questionOrder: string[] (question ids in display order).
  // optionMap: Record<questionId, string[]> display position → original letter.
  // Stored at attempt start; refresh-safe; evaluation inverts the mapping.
  questionOrder Json?
  optionMap     Json?
  score       Float         @default(0)
  totalMarks  Float         @default(0)
  percentage  Float         @default(0)
  status      AttemptStatus @default(IN_PROGRESS)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  test    Test    @relation(fields: [testId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([studentId])
  @@index([studentId, testId])
  @@index([status])
}

// Phase 12 — PDF import session. Tracks one upload through
// PROCESSING → COMPLETED | REVIEW_REQUIRED | FAILED.
// Questions land on a staging test (see Question.reviewStatus); only
// APPROVED rows enter the usable pool. Binaries are never stored —
// metadata + structured rows only (Supabase Storage later if needed).
model PdfImport {
  id                String   @id @default(cuid())
  filename          String
  status            String   @default("PROCESSING")
  totalPages        Int      @default(0)
  textPages         Int      @default(0)
  ocrPages          Int      @default(0)
  questionsDetected Int      @default(0)
  questionsApproved Int      @default(0)
  questionsRejected Int      @default(0)
  stagingTestId     String?
  createdById       String?
  error             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  createdBy User? @relation("PdfImportCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

// Database model only in Phase 3. eSSL/biometric connection is a later
// phase — source=BIOMETRIC + deviceId exist so no rework is needed then.
model Attendance {
  id        String           @id @default(cuid())
  studentId String
  batchId   String
  date      DateTime         @db.Date
  status    AttendanceStatus @default(PRESENT)
  checkIn   DateTime?
  checkOut  DateTime?
  source    AttendanceSource @default(MANUAL)
  deviceId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([batchId, date])
}

model Notification {
  id              String               @id @default(cuid())
  title           String
  message         String
  type            String               @default("general")
  audience        NotificationAudience @default(ALL_STUDENTS)
  // Phase 13 — delivery channel + in-app read state. WEB_PUSH/MOBILE_PUSH
  // rows are stored but delivery providers land in a later phase.
  channel         NotificationChannel  @default(IN_APP)
  // Phase 18c-step3 — persisted priority + requested multi-channel policy +
  // persistent idempotency key (one logical send = one key). Multi-row
  // dispatches (ALL_USERS, cohort fan-out) store "<key>#<shard>" per row so
  // the unique constraint still dedupes concurrent retries race-safely.
  priority          NotificationPriority @default(NORMAL)
  requestedChannels DeliveryChannel[]    @default([])
  idempotencyKey    String?              @unique
  isRead          Boolean              @default(false)
  readAt          DateTime?
  // Optional deep link to a test (e.g. "new scholarship test available").
  testId          String?
  createdById     String?
  targetBatchId   String?
  targetStudentId String?
  targetFacultyId String?
  targetUserId    String?
  scheduledAt     DateTime?
  sentAt          DateTime?
  status          NotificationStatus   @default(DRAFT)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  createdBy     User?    @relation("NotificationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  targetBatch   Batch?   @relation("NotificationBatch", fields: [targetBatchId], references: [id], onDelete: SetNull)
  targetStudent Student? @relation("NotificationStudent", fields: [targetStudentId], references: [id], onDelete: SetNull)
  targetFaculty Faculty? @relation("NotificationFaculty", fields: [targetFacultyId], references: [id], onDelete: SetNull)
  targetUser    User?    @relation("NotificationUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  // Phase 16 — per-user read receipts (broadcast-safe).
  reads         NotificationRead[]
  // Phase 18c-step3 — per-recipient per-channel delivery audit. Cascade:
  // deleting a Notification removes its delivery rows (admin cleanup).
  deliveries    NotificationDelivery[]

  @@index([targetStudentId])
  @@index([targetUserId])
  @@index([targetBatchId])
  @@index([targetFacultyId])
  @@index([status])
  @@index([channel])
  @@index([audience])
  @@index([createdAt])
  @@index([type])
  @@index([priority])
  @@index([scheduledAt])
}

// Phase 16 — per-user read receipts for broadcast notifications.
// Notification.isRead is a single shared column: flipping it for an
// ALL_STUDENTS/BATCH broadcast would clear unread state for every other
// recipient. Individually-targeted rows (targetStudentId/targetUserId)
// keep using the shared flag (single recipient — safe); broadcasts use
// one receipt row per reader. Never trusted from the client: rows are
// created only from the session identity in PATCH /api/notifications/mine.
model NotificationRead {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@index([notificationId])
}

// Phase 18c-step3 — persistent per-recipient per-channel delivery audit.
// One row per (notification, channel, recipient). NEVER stores: OTP,
// MSG91 auth key, VAPID private key, raw provider responses, phone
// numbers beyond the recipient identity already on User/Student/Faculty,
// or any authentication secret. Safe diagnostics only (errorCode +
// truncated safe message). Retry foundation only: retryable/attemptCount/
// nextAttemptAt persist, but no worker auto-retries (later phase).
model NotificationDelivery {
  id             String             @id @default(cuid())
  notificationId String
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  // Recipient identity: User FK where resolvable; studentId/facultyId are
  // plain profile references (no profile duplication). recipientKey is the
  // deterministic dedup identity (user:<id> | student:<id> | faculty:<id> |
  // name:<truncated-name> when no id is resolvable) and backs the race-safe
  // unique.
  userId       String?
  user         User?              @relation("DeliveryRecipient", fields: [userId], references: [id], onDelete: SetNull)
  studentId    String?
  facultyId    String?
  recipientKey String
  channel      DeliveryChannel
  status       DeliveryStatus     @default(CREATED)
  priority     NotificationPriority @default(NORMAL)
  provider     DeliveryProvider   @default(IN_APP)
  // Provider reference only (MSG91 request id when returned). Never the
  // raw provider payload.
  providerMessageId String?
  // Safe machine code (SMS_NOT_CONFIGURED, SMS_PROVIDER_ERROR, ...) +
  // truncated human-safe message. Never secrets/phones/bodies.
  errorCode    String?
  errorMessage String?
  retryable    Boolean            @default(false)
  attemptCount Int                @default(0)
  lastAttemptAt DateTime?
  // Retry foundation only (worker lands later — never auto-retried here).
  nextAttemptAt DateTime?
  queuedAt     DateTime?
  sentAt       DateTime?
  deliveredAt  DateTime?
  failedAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([notificationId, channel, recipientKey])
  @@index([notificationId])
  @@index([channel])
  @@index([status])
  @@index([priority])
  @@index([userId])
  @@index([recipientKey])
  @@index([createdAt])
  @@index([retryable])
  @@index([channel, status])
  @@index([status, retryable])
}

// Phase 13 — mobile OTP verification requests. The plaintext OTP is NEVER
// stored: only a peppered SHA-256 hash. Never returned, never logged.
model OtpRequest {
  id          String    @id @default(cuid())
  phone       String
  purpose     String    @default("REGISTER")
  otpHash     String
  attempts    Int       @default(0)
  resendCount Int       @default(0)
  expiresAt   DateTime
  verifiedAt  DateTime?
  consumed    Boolean   @default(false)
  lastSentAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([phone])
  @@index([expiresAt])
}

// Phase 13 — Web Push subscription foundation (browser push lands later).
// Storing subscriptions now means no rework when the provider is added.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String?
  auth      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Homepage results-showcase CMS (toppers wall). Display-only marketing rows,
// deliberately decoupled from the Result marks table: publishing here never
// exposes student phone, email, login identity, marks history or any private
// record. Only a display name (+ optional admin-supplied image URL) is
// stored. Publication requires explicit consent (see isActive rule enforced
// in app/api/showcase/route.ts): drafts stay invisible until an admin both
// confirms consent and activates the row.
model ResultShowcase {
  id          String   @id @default(cuid())
  studentName String
  exam        String   @default("JEE Main")
  achievement String
  score       String?
  year        String   @default("")
  imageUrl    String?
  displayOrder Int     @default(0)
  // Consent/approval for publishing an identifiable name/photo. The public
  // endpoint only serves rows with consent AND isActive both true.
  consent     Boolean  @default(false)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, displayOrder])
}

// Phase 14 — study material library. Only isActive books are visible to
// students; visibleTo controls scholarship-student access per book.
model Book {
  id           String         @id @default(cuid())
  title        String
  description  String?
  author       String?
  subject      String?
  className    String?
  category     String?
  coverImageUrl String?
  pdfUrl       String?
  externalUrl  String?
  visibleTo    BookVisibility @default(ALL)
  isActive     Boolean        @default(true)
  order        Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([isActive, order])
  @@index([className])
  @@index([subject])
  @@index([category])
}

model Enquiry {
  id        String        @id @default(cuid())
  name      String
  phone     String
  email     String?
  courseId  String?
  message   String?
  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model Announcement {
  id             String   @id @default(cuid())
  title          String
  content        String
  imageUrl       String?
  targetAudience String   @default("ALL")
  startDate      DateTime?
  endDate        DateTime?
  isActive       Boolean  @default(true)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  createdBy User? @relation("AnnouncementCreator", fields: [createdById], references: [id], onDelete: SetNull)
}

// ================================================================
// Biometric Device Management (Phase 12A, additive, no rework)
// ================================================================
// Device authentication: BiometricDevice.authSecretHash stores a SHA-256 hex
// of the per-device shared secret. The plaintext secret is shown ONCE at
// provisioning/rotation and never stored or logged. Ingestion endpoints
// compare with crypto.timingSafeEqual. Devices without a secret operate in
// legacy mode (accepted, flagged) until a secret is provisioned.
// IP allowlist: when BiometricDevice.ipAddress is set, ADMS pushes from any
// other source IP are rejected (401). Unset = no IP restriction.
model BiometricDevice {
  id           String   @id @default(cuid())
  name         String
  serialNumber String   @unique
  deviceType   String   @default("X2000")
  ipAddress    String?
  port         Int?
  protocol     String   @default("ADMS")
  location     String?
  isActive     Boolean  @default(true)
  lastSeenAt   DateTime?
  // Last device-initiated heartbeat (ADMS registration / ping / getrequest).
  lastHeartbeatAt DateTime?
  // Last ingestion failure, human-readable (no secrets, no PII beyond IDs).
  lastError    String?
  // SHA-256 hex of the per-device shared secret. NULL = legacy mode.
  authSecretHash String?
  totalEvents  Int      @default(0)
  failedEvents Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mappings BiometricUserMap[]

  @@index([isActive])
  @@index([lastSeenAt])
}

model BiometricDeviceEvent {
  id              String   @id @default(cuid())
  deviceId        String?
  biometricUserId String
  eventTimestamp  DateTime @default(now())
  eventType       String
  payloadHash     String   @db.VarChar(64)
  processed       Boolean  @default(false)
  attendanceId    String?
  receivedAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([deviceId])
  @@index([biometricUserId])
  @@index([processed])
  @@index([eventTimestamp])

  @@unique([deviceId, biometricUserId, eventTimestamp, payloadHash])
}

// Persistent biometric enrollment mapping (post-capture schema phase).
// One row binds a device-local enrollment ID (the PIN the K90 sends) to a
// Neuron Academy record. Ingestion resolves mappings FIRST; the legacy
// fuzzy match (studentId/email) is only a fallback for unmapped IDs and
// never creates attendance for non-student targets.
enum BiometricUserType {
  STUDENT
  FACULTY
}

model BiometricUserMap {
  id              String            @id @default(cuid())
  deviceId        String
  biometricUserId String
  userType        BiometricUserType
  // Student.id or Faculty.id (canonical record id, never a display code).
  userId          String
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  device BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, biometricUserId])
  @@index([deviceId])
  @@index([userType, userId])
}

// ================================================================
// Student engagement additions (additive only — no rework).
// ================================================================

// "Revise later" bookmarks: student-owned, server-persisted so they work
// across devices. Never affect scores, attempts, or evaluation.
model Bookmark {
  id         String   @id @default(cuid())
  studentId  String
  testId     String
  questionId String
  note       String?
  createdAt  DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([studentId, questionId])
  @@index([studentId])
  @@index([testId])
}

// Weekly class timetable. dayOfWeek 0=Sunday..6=Saturday; times "HH:MM" 24h.
// Admin-managed; students see their batch grid, faculty see their classes.
model TimetableEntry {
  id        String   @id @default(cuid())
  batchId   String
  subject   String
  title     String?
  facultyId String?
  dayOfWeek Int
  startTime String
  endTime   String
  room      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch   Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: SetNull)

  @@index([batchId, dayOfWeek])
  @@index([facultyId])
}

enum DoubtStatus {
  ASKED
  ANSWERED
  CLOSED
}

// Doubt-solving: students ask (own batch context), faculty/Admin answer.
// v1 is text Q&A; photo upload is a documented follow-up.
model Doubt {
  id           String      @id @default(cuid())
  studentId    String
  batchId      String?
  subject      String?
  questionText String
  status       DoubtStatus @default(ASKED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch   Batch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  replies DoubtReply[]

  @@index([batchId, status])
  @@index([studentId])
}

model DoubtReply {
  id           String   @id @default(cuid())
  doubtId      String
  authorRole   String   @default("FACULTY")
  authorUserId String?
  authorName   String
  text         String
  createdAt    DateTime @default(now())

  doubt Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)

  @@index([doubtId])
}

// Study material library (notes / videos / links / PDFs live at URLs).
// Admin-curated; students browse/search. Separate from Books (which are
// physical-library catalogue rows with storage files).
model Material {
  id           String   @id @default(cuid())
  title        String
  subject      String?
  className    String?
  kind         String   @default("NOTE")
  url          String?
  description  String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
}
